APP_NAME=Planoo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://127.0.0.1:8000
APP_TIMEZONE=Asia/Damascus
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
AUTH_GUARD=partner:api

CONFLICTS_DETECTION=true

JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=12000

WHATSAPP_TOKEN="your_permanent_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_here"
WHATSAPP_VERSION="v20.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="create_your_own_random_secure_string_here"

SYRIATEL_USER_NAME=
SYRIATEL_PASSWORD=
SYRIATEL_SENDER=
SYRIATEL_WEBHOOK_URL=http://planoo.sy/webhooks.php
# Must match PLANOO_WEBHOOK_SECRET configured on the webhook proxy server
SYRIATEL_WEBHOOK_SECRET=PlanooApp1_webhook_secret

# Comma separated list of origins allowed to call the API (CORS), e.g.
# CORS_ALLOWED_ORIGINS=https://app.planoo.sy,https://admin.planoo.sy
CORS_ALLOWED_ORIGINS=

PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
